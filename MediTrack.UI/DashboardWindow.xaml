<Window x:Class="MediTrack.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediTrack Pro - Dashboard" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/> <!-- Sidebar Column -->
            <ColumnDefinition Width="*"/>   <!-- Dynamic Content Column -->
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="#1E293B" Padding="15">
            <StackPanel>
                <!-- User Profile Header -->
                <TextBlock x:Name="TxtWelcome" Text="Welcome, User" Foreground="White" 
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock x:Name="TxtRole" Text="Role: Admin" Foreground="#94A3B8" 
                           FontSize="12" Margin="0,0,0,25"/>

                <Separator Background="#334155" Margin="0,0,0,15"/>

                <!-- Role-Restricted Navigation Buttons -->
                <Button x:Name="BtnDashboard" Content="📊 Dashboard" Height="38" Margin="0,0,0,8" Click="BtnDashboard_Click"
                        Background="#334155" Foreground="White" HorizontalContentAlignment="Left" Padding="10,0,0,0"/>
                
                <Button x:Name="BtnPatients" Content="👥 Patients" Height="38" Margin="0,0,0,8" Click="BtnPatients_Click"
                        Background="#334155" Foreground="White" HorizontalContentAlignment="Left" Padding="10,0,0,0"/>
                
                <Button x:Name="BtnAppointments" Content="📅 Appointments" Height="38" Margin="0,0,0,8" Click="BtnAppointments_Click"
                        Background="#334155" Foreground="White" HorizontalContentAlignment="Left" Padding="10,0,0,0"/>
                
                <Button x:Name="BtnPrescriptions" Content="💊 Prescriptions" Height="38" Margin="0,0,0,8" Click="BtnPrescriptions_Click"
                        Background="#334155" Foreground="White" HorizontalContentAlignment="Left" Padding="10,0,0,0"/>
                
                <Button x:Name="BtnBilling" Content="💳 Billing &amp; Inventory" Height="38" Margin="0,0,0,8" Click="BtnBilling_Click"
                        Background="#334155" Foreground="White" HorizontalContentAlignment="Left" Padding="10,0,0,0"/>

                <Button x:Name="BtnUserManagement" Content="⚙️ User Management" Height="38" Margin="0,0,0,8" Click="BtnUserManagement_Click"
                        Background="#334155" Foreground="White" HorizontalContentAlignment="Left" Padding="10,0,0,0"/>

                <!-- Logout Button -->
                <Button x:Name="BtnLogout" Content="🚪 Logout" Height="38" Margin="0,30,0,0" 
                        Background="#EF4444" Foreground="White" FontWeight="Bold" Click="BtnLogout_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Display Content Area -->
        <Grid Grid.Column="1" Background="#F8FAFC">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>