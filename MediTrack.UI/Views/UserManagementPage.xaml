<Page x:Class="MediTrack.UI.Pages.UserManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="User Management">

    <Border Padding="20" Background="#F8FAFC">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="15" CornerRadius="8" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="👤 User Management" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                    <TextBlock Text="Full Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtFullName" Height="32" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtUsername" Height="32" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtPassword" Height="32" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Role" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbRole" Height="32" Margin="0,0,0,12" SelectedIndex="0" SelectionChanged="CmbRole_SelectionChanged">
                        <ComboBoxItem Content="Receptionist"/>
                        <ComboBoxItem Content="Doctor"/>
                        <ComboBoxItem Content="Admin"/>
                    </ComboBox>

                    <StackPanel x:Name="DoctorDetailsPanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Specialization" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtSpecialization" Height="32" Padding="5" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Content="➕ Create Staff Account" Height="38" Background="#2563EB" Foreground="White"
                            FontWeight="Bold" Click="BtnCreateUser_Click" Margin="0,0,0,10"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Registered System Accounts" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                    <DataGrid x:Name="GridUsers" AutoGenerateColumns="False" Height="420" Background="White" IsReadOnly="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="50"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="160"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding IsActive}" Width="80"/>
                            <DataGridTemplateColumn Header="Actions" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Toggle Active State" Background="#E2E8F0" Foreground="#1E293B"
                                                Padding="5,2" Click="BtnToggleStatus_Click" Tag="{Binding UserId}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Page>