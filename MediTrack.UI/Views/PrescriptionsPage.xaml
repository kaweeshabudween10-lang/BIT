<Page x:Class="MediTrack.UI.Pages.PrescriptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Doctor Consultation">

    <Border Padding="20" Background="#F8FAFC">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="15" CornerRadius="8" Margin="0,0,15,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🩺 Doctor Consultation" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                        <TextBlock Text="Patient" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbPrescriptionPatient" DisplayMemberPath="FullName" Height="32" Margin="0,0,0,12"/>

                        <TextBlock Text="Doctor" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbPrescriptionDoctor" DisplayMemberPath="FullName" Height="32" Margin="0,0,0,12"/>

                        <TextBlock Text="Diagnosis" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtDiagnosis" Height="30" Padding="5" Margin="0,0,0,10"/>

                        <TextBlock Text="Consultation Notes" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtNotes" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="5" Margin="0,0,0,15"/>

                        <Separator Margin="0,0,0,15"/>

                        <TextBlock Text="Add Medicine" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,10"/>

                        <TextBlock Text="Medicine Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtMedName" Height="30" Padding="5" Margin="0,0,0,10"/>

                        <TextBlock Text="Dosage (e.g. 1 tablet BD after food)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtDosage" Height="30" Padding="5" Margin="0,0,0,10"/>

                        <TextBlock Text="Duration (e.g. 5 Days)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtDuration" Height="30" Padding="5" Margin="0,0,0,15"/>

                        <Button Content="➕ Add Item to Rx List" Height="35" Background="#10B981" Foreground="White" FontWeight="Bold" Click="BtnAddItem_Click" Margin="0,0,0,20"/>
                        <Button Content="💾 Save &amp; Export PDF Prescription" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="BtnSavePdf_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Prescribed Medicines List" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>
                    <DataGrid x:Name="GridRxItems" AutoGenerateColumns="False" Height="380" Background="White" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Medicine" Binding="{Binding MedicineName}" Width="*"/>
                            <DataGridTextColumn Header="Dosage" Binding="{Binding Dosage}" Width="200"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Page>
