<Page x:Class="MediTrack.UI.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Admin Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
        <Border Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="280"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                    <Border Background="White" Padding="15" CornerRadius="8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Total Patients" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTotalPatients" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="15" CornerRadius="8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Today's Appointments" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTodayAppointments" Text="0" FontSize="22" FontWeight="Bold" Foreground="#2563EB" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="15" CornerRadius="8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Monthly Revenue" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtMonthlyRevenue" Text="LKR 0.00" FontSize="22" FontWeight="Bold" Foreground="#059669" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Padding="15" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="High-Risk Watchlist" Foreground="#991B1B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtAtRiskCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="#DC2626" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Border Background="White" Padding="15" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="📈 Monthly Revenue Trend (LKR)" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            <lvc:CartesianChart Grid.Row="1" x:Name="ChartRevenue" Series="{Binding RevenueSeries}" XAxes="{Binding XAxes}"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="White" Padding="15" CornerRadius="8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="⚠️ Patient Risk &amp; Follow-up Watchlist" FontSize="16" FontWeight="Bold" Foreground="#1E293B" DockPanel.Dock="Left"/>
                            <TextBlock Text="Rule-based Smart Risk Engine" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>

                        <DataGrid x:Name="GridWatchlist" AutoGenerateColumns="False" Height="220" IsReadOnly="True" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientId}" Width="80"/>
                                <DataGridTextColumn Header="Patient Name" Binding="{Binding PatientName}" Width="160"/>
                                <DataGridTextColumn Header="Phone Number" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="Risk Score" Binding="{Binding CalculatedScore}" Width="90"/>
                                <DataGridTextColumn Header="Risk Level" Binding="{Binding RiskLevel}" Width="100"/>
                                <DataGridTextColumn Header="Trigger Reasons" Binding="{Binding RiskReasons[0]}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</Page>