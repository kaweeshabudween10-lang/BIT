<Page x:Class="MediTrack.UI.Pages.PatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Patient Management">

    <Grid Background="#F8FAFC">
        <Border Padding="20">
            <StackPanel>
            <TextBlock Text="👥 Patient Management" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
            <TextBlock Text="Search, add, and manage patient records." FontSize="14" Foreground="#64748B" Margin="0,0,0,20"/>
            
            <!-- Search Control Panel -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBox x:Name="TxtSearch" Width="250" Height="35" Padding="5" VerticalContentAlignment="Center"/>
                <Button Content="Search" Width="80" Height="35" Margin="10,0,0,0" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="BtnSearch_Click"/>
                <Button Content="Refresh" Width="80" Height="35" Margin="10,0,0,0" Background="#64748B" Foreground="White" FontWeight="Bold" Click="BtnRefresh_Click"/>
            </StackPanel>

            <!-- Patient DataGrid -->
            <DataGrid x:Name="GridPatients" AutoGenerateColumns="False" Height="350"
                      Background="White" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PatientId}" Width="50"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="180"/>
                    <DataGridTextColumn Header="NIC" Binding="{Binding NIC}" Width="110"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="Blood Group" Binding="{Binding BloodGroup}" Width="90"/>
                    <DataGridTextColumn Header="Allergies" Binding="{Binding Allergies}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Chronic?" Binding="{Binding ChronicConditionFlag}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</Page>