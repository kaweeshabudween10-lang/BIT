<Page x:Class="MediTrack.UI.Pages.BillingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Billing &amp; Inventory">

    <Border Padding="20" Background="#F8FAFC">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="15" CornerRadius="8" Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="💳 Generate Invoice" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                    <TextBlock Text="Visit ID" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtVisitId" Height="30" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Consultation Fee (LKR)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtConsultFee" Text="1500" Height="30" Padding="5" Margin="0,0,0,10" LostFocus="CalculateTotal"/>

                    <TextBlock Text="Medicine Total (LKR)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtMedTotal" Text="500" Height="30" Padding="5" Margin="0,0,0,15" LostFocus="CalculateTotal"/>

                    <Border Background="#F1F5F9" Padding="10" CornerRadius="5" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Payable:" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtTotalPayable" Grid.Column="1" Text="LKR 2000.00" FontSize="16" FontWeight="Bold" Foreground="#2563EB"/>
                        </Grid>
                    </Border>

                    <Button Content="💾 Process Payment &amp; Save Invoice" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="BtnProcessInvoice_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" x:Name="BannerLowStock" Background="#FEE2E2" BorderBrush="#EF4444"
                        BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,0,0,15" Visibility="Collapsed">
                    <TextBlock x:Name="TxtLowStockAlert" Text="⚠️ Warning: Some medicine stock levels are below reorder limits!"
                               Foreground="#991B1B" FontWeight="Bold"/>
                </Border>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="📦 Pharmacy Inventory Stock" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                    <DataGrid x:Name="GridInventory" AutoGenerateColumns="False" Height="340" Background="White" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding MedicineId}" Width="50"/>
                            <DataGridTextColumn Header="Medicine Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="In Stock" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="Reorder Level" Binding="{Binding ReorderLevel}" Width="110"/>
                            <DataGridTextColumn Header="Unit Price (LKR)" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Page>
