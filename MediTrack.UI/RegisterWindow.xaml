<Window x:Class="MediTrack.UI.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Account - MediTrack Pro" Height="500" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Create your account" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="#1F2937"/>
            <TextBlock Text="MediTrack Pro" FontSize="14" HorizontalAlignment="Center"
                       Margin="0,0,0,22" Foreground="#6B7280"/>

            <TextBlock Text="Full name" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtFullName" Height="35" FontSize="14" Padding="5"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtUsername" Height="35" FontSize="14" Padding="5"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="35" FontSize="14" Padding="5"
                         Margin="0,0,0,12"/>

            <TextBlock Text="Account type: Receptionist" Foreground="#4B5563"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="LblMessage" MinHeight="20" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Button Content="Register" Height="40" Background="#2563EB" Foreground="White"
                    FontSize="15" FontWeight="Bold" Click="BtnRegister_Click"/>
            <Button Content="Back to login" Height="36" Margin="0,8,0,0"
                    Background="Transparent" Foreground="#2563EB" FontSize="14"
                    Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>