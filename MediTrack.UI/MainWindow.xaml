<Window x:Class="MediTrack.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediTrack Pro - Login" Height="400" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <!-- App Title -->
            <TextBlock Text="MediTrack Pro" FontSize="26" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="#1F2937"/>
            <TextBlock Text="Clinic Management System" FontSize="14" 
                       HorizontalAlignment="Center" Margin="0,0,0,25" Foreground="#6B7280"/>

            <!-- Username Input -->
            <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtUsername" Height="35" FontSize="14" Padding="5" Margin="0,0,0,15"/>

            <!-- Password Input -->
            <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPassword" Height="35" FontSize="14" Padding="5" Margin="0,0,0,15"/>

            <!-- Error Message Label -->
            <TextBlock x:Name="LblError" Foreground="Red" FontSize="12" 
                       HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

            <!-- Login Button -->
            <Button x:Name="BtnLogin" Content="Login" Height="40" Background="#2563EB" 
                    Foreground="White" FontSize="15" FontWeight="Bold" Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>